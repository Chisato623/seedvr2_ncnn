@@ -692,6 +692,29 @@ void VkBlobAllocator::clear()
     d->image_memory_budgets.clear();
 }
 
+void VkBlobAllocator::trim()
+{
+    for (size_t i = d->buffer_blocks.size(); i > 0; i--)
+    {
+        const size_t index = i - 1;
+        const std::list<std::pair<size_t, size_t> >& budget =
+            d->buffer_budgets[index];
+        VkBufferMemory* ptr = d->buffer_blocks[index];
+        if (budget.size() != 1 || budget.front().first != 0 ||
+            budget.front().second != ptr->capacity)
+            continue;
+
+        if (mappable)
+            vkUnmapMemory(vkdev->vkdevice(), ptr->memory);
+        vkDestroyBuffer(vkdev->vkdevice(), ptr->buffer, 0);
+        vkFreeMemory(vkdev->vkdevice(), ptr->memory, 0);
+        delete ptr;
+
+        d->buffer_blocks.erase(d->buffer_blocks.begin() + index);
+        d->buffer_budgets.erase(d->buffer_budgets.begin() + index);
+    }
+}
+
 VkBufferMemory* VkBlobAllocator::fastMalloc(size_t size)
 {
     size_t aligned_size = alignSize(size, d->buffer_offset_alignment);
@@ -799,6 +822,7 @@ VkBufferMemory* VkBlobAllocator::fastMalloc(size_t size)
     }
 
     block->memory_type_index = buffer_memory_type_index;
+    block->capacity = new_block_size;
 
     d->buffer_blocks.push_back(block);
 
